# --- providers ---------------------------------------------------------------
# deepseek | anthropic | groq | openrouter | mock
#
# Cost per complex research run (~72k input / 15k output tokens):
#   deepseek   ~$0.026   <- default; the whole project runs on a few dollars
#   anthropic  ~$0.26    Sonnet + Haiku. ~10x more, for a final comparison run
#   groq       ~$0.00    free tier, but 6k tokens/min throttles a run to ~15 min
#   mock       $0        no network at all; for testing plumbing and logic
#
# The token count is identical across all of these — only the model price
# changes. That is where the cost lives, not in the number of tokens.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- models per role ---------------------------------------------------------
# Frontier model where judgment matters; cheap models where volume matters.
# Lead and critic carry the quality; subagents carry the volume.

# default profile (DeepSeek)
LEAD_MODEL=deepseek-v4-pro
CRITIC_MODEL=deepseek-v4-pro
SUBAGENT_MODEL=deepseek-v4-flash
CITATION_MODEL=deepseek-v4-flash

# comparison profile (Anthropic) — swap in when LLM_PROVIDER=anthropic
# LEAD_MODEL=claude-sonnet-5
# CRITIC_MODEL=claude-sonnet-5
# SUBAGENT_MODEL=claude-haiku-4-5
# CITATION_MODEL=claude-haiku-4-5

# --- research tools ----------------------------------------------------------
# exa | tavily | groq_builtin
#   exa           - neural search, 20k free requests/month (recommended)
#   tavily        - search + extract in one call, 1k free credits/month
#   groq_builtin  - groq/compound's own web_search; zero setup, but the results
#                   are a black box: no source URLs to cite, no cross-subagent
#                   dedup, no per-search tracing. Baseline phase only.
SEARCH_PROVIDER=exa

EXA_API_KEY=
TAVILY_API_KEY=

# nlquery-agent MCP server (database subagent)
NLQUERY_MCP_COMMAND=python
NLQUERY_MCP_ARGS=../NLQuery-agent/mcp_server.py

# --- limits ------------------------------------------------------------------
MAX_SUBAGENTS=5
MAX_RESEARCH_ROUNDS=3
SUBAGENT_TIMEOUT_S=300
MAX_COST_USD_PER_RUN=1.00
