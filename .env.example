# --- llm --------------------------------------------------------------------
# deepseek | anthropic | groq | openrouter | mock (no network, for tests)
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# A strong model where judgement matters, a cheap one where volume matters.
LEAD_MODEL=deepseek-v4-pro
CRITIC_MODEL=deepseek-v4-pro
SUBAGENT_MODEL=deepseek-v4-flash
CITATION_MODEL=deepseek-v4-flash

# with LLM_PROVIDER=anthropic:
# LEAD_MODEL=claude-sonnet-5
# CRITIC_MODEL=claude-sonnet-5
# SUBAGENT_MODEL=claude-haiku-4-5
# CITATION_MODEL=claude-haiku-4-5

# --- search -----------------------------------------------------------------
# exa | mock
SEARCH_PROVIDER=exa
EXA_API_KEY=

# --- database (nlquery-agent over MCP) --------------------------------------
NLQUERY_MCP_COMMAND=python
NLQUERY_MCP_ARGS=../NLQuery-agent/mcp_server.py
# models nlquery-agent uses for SQL (Groq retired the llama ones it defaults to)
NLQUERY_FAST_MODEL=openai/gpt-oss-20b
NLQUERY_SMART_MODEL=openai/gpt-oss-120b

# --- limits -----------------------------------------------------------------
MAX_SUBAGENTS=5
MAX_RESEARCH_ROUNDS=3
SUBAGENT_TIMEOUT_S=300
MAX_COST_USD_PER_RUN=1.00
